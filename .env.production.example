# ─── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Hours before JWT token expires (default 24)
JWT_EXPIRY_HOURS=24

# Comma-separated emails that get the 'admin' role on first registration
ADMIN_EMAILS=you@enset.ma,admin@enset.ma

# Optional: restrict registration to specific email domains (leave blank to allow all)
# Example: ALLOWED_EMAIL_DOMAINS=enset.ma,gmail.com
ALLOWED_EMAIL_DOMAINS=

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_CHAT=30 per hour
RATE_LIMIT_UPLOAD=20 per day

# Enable only when the backend is reachable exclusively through the trusted
# reverse proxy configured by docker-compose.prod.yml.
TRUST_PROXY_HEADERS=true

# ─── LLM Providers (fill at least one) ────────────────────────────────────────
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── LLM Defaults ──────────────────────────────────────────────────────────────
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# ─── Infrastructure ────────────────────────────────────────────────────────────
# Inside Docker, chromadb is the service name — do not change
CHROMA_HOST=chromadb
CHROMA_PORT=8000
UPLOAD_DIR=/app/uploads

# ─── RAG Tuning ────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
MAX_HISTORY_TURNS=6
SESSION_TTL_SECONDS=3600
