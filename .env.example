# ── Primary LLM Providers (free, set at least one) ────────────────────────────

# Gemini (Google) — free tier, 1M token context, strong quality
# Get key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Cerebras — ultra-fast inference on wafer-scale chips, free tier
# Get key at: https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here

# ── Optional Providers ─────────────────────────────────────────────────────────

# Groq — fast inference, free tier → https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here

# Anthropic (Claude) — best reasoning, 200K context → https://console.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT-4o) → https://platform.openai.com
# OPENAI_API_KEY=your_openai_api_key_here

# Ollama (local) — no key needed, install Ollama then: ollama pull llama3
# OLLAMA_HOST=http://localhost:11434

# ── Default provider/model shown on first load ─────────────────────────────────
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.0-flash

# ── LLM Settings ───────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# ── ChromaDB ───────────────────────────────────────────────────────────────────
# docker-compose overrides CHROMA_HOST=chromadb automatically
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── File Storage ───────────────────────────────────────────────────────────────
# Local development defaults to filesystem storage. docker-compose uses MinIO
# through the S3-compatible backend.
UPLOAD_DIR=./uploads
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PREFIX=documents
S3_BUCKET=enset-ai-documents
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ensetai
S3_SECRET_ACCESS_KEY=ensetai-dev-password
MINIO_ROOT_USER=ensetai
MINIO_ROOT_PASSWORD=ensetai-dev-password

# ── RAG Tuning ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# ── Session Memory ─────────────────────────────────────────────────────────────
MAX_HISTORY_TURNS=6

# REQUIRED for production — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production

# ── Rate-limit storage ─────────────────────────────────────────────────────────
# Required for multi-worker deployments so limits are shared across processes.
# docker-compose sets this to redis://redis:6379/0 automatically.
REDIS_URL=redis://localhost:6379/0

# ── Metadata Database ──────────────────────────────────────────────────────────
# Leave blank for local SQLite. docker-compose uses Postgres.
DATABASE_URL=
POSTGRES_DB=enset_ai
POSTGRES_USER=enset_ai
POSTGRES_PASSWORD=enset-ai-dev-password

# ── Vector Store ───────────────────────────────────────────────────────────────
# Local development defaults to Chroma. docker-compose uses Qdrant.
VECTOR_STORE_BACKEND=chroma
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Trust one reverse proxy hop for X-Forwarded-For / X-Forwarded-Proto.
# Keep false when the backend is directly reachable by browsers/clients.
TRUST_PROXY_HEADERS=false
